generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum PromiseStatus { ACTIVE FULFILLED BROKEN EXPIRED }
enum MessageCategory { BOARD PLAYER AGENT STAFF PRESS MARKET }
enum TransferStatus { INTEREST INQUIRY OFFER NEGOTIATING ACCEPTED REJECTED COMPLETED CANCELLED }

model User { id String @id @default(cuid()); email String @unique; name String?; createdAt DateTime @default(now()); saves SaveGame[] }
model SaveGame { id String @id @default(cuid()); userId String; name String; gameSeed String; tick Int @default(0); currentDate DateTime; stateVersion Int @default(1); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade); manager Manager?; worldEvents WorldEvent[]; @@index([userId,updatedAt]) }
model Manager { id String @id @default(cuid()); saveGameId String @unique; clubId String?; name String; reputation Int @default(25); boardConfidence Int @default(60); fanRelationship Int @default(0); pressRelationship Int @default(0); matches Int @default(0); wins Int @default(0); draws Int @default(0); losses Int @default(0); saveGame SaveGame @relation(fields:[saveGameId],references:[id],onDelete:Cascade); club Club? @relation(fields:[clubId],references:[id]); promises Promise[] }
model Country { id String @id @default(cuid()); name String; code String @unique; competitions Competition[]; clubs Club[] }
model Competition { id String @id @default(cuid()); countryId String; name String; level Int @default(1); country Country @relation(fields:[countryId],references:[id]); seasons Season[] }
model Season { id String @id @default(cuid()); competitionId String; year Int; status String; competition Competition @relation(fields:[competitionId],references:[id]); fixtures Fixture[]; standings Standing[]; @@unique([competitionId,year]) }
model Stadium { id String @id @default(cuid()); name String; city String; capacity Int; clubs Club[] }
model Club { id String @id @default(cuid()); countryId String; stadiumId String?; name String; shortName String; reputation Int; budget Decimal @db.Decimal(14,2); wageBudget Decimal @db.Decimal(14,2); country Country @relation(fields:[countryId],references:[id]); stadium Stadium? @relation(fields:[stadiumId],references:[id]); players Player[]; managers Manager[]; homeFixtures Fixture[] @relation("HomeClub"); awayFixtures Fixture[] @relation("AwayClub"); standings Standing[]; expectations BoardExpectation[] }
model Agent { id String @id @default(cuid()); name String; reputation Int; aggression Int; influence Int; players Player[] }
model Player { id String @id @default(cuid()); clubId String?; agentId String?; name String; birthDate DateTime; nationality String; position String; overall Int; morale Int @default(70); condition Int @default(100); fatigue Int @default(0); reputation Int @default(10); squadStatus String; club Club? @relation(fields:[clubId],references:[id]); agent Agent? @relation(fields:[agentId],references:[id]); attributes PlayerAttributes?; personality PlayerPersonality?; contract Contract?; injuries Injury[]; suspensions Suspension[]; promises Promise[]; @@index([clubId,position]) }
model PlayerAttributes { playerId String @id; technique Int; passing Int; finishing Int; marking Int; pace Int; strength Int; stamina Int; positioning Int; creativity Int; player Player @relation(fields:[playerId],references:[id],onDelete:Cascade) }
model PlayerPersonality { playerId String @id; professionalism Int; ambition Int; loyalty Int; temperament Int; pressure Int; ego Int; leadership Int; player Player @relation(fields:[playerId],references:[id],onDelete:Cascade) }
model Contract { id String @id @default(cuid()); playerId String @unique; salary Decimal @db.Decimal(12,2); startsAt DateTime; expiresAt DateTime; releaseClause Decimal? @db.Decimal(14,2); player Player @relation(fields:[playerId],references:[id],onDelete:Cascade) }
model Fixture { id String @id @default(cuid()); seasonId String; homeClubId String; awayClubId String; round Int; scheduledAt DateTime; status String; season Season @relation(fields:[seasonId],references:[id]); homeClub Club @relation("HomeClub",fields:[homeClubId],references:[id]); awayClub Club @relation("AwayClub",fields:[awayClubId],references:[id]); match Match?; @@unique([seasonId,round,homeClubId]) }
model Match { id String @id @default(cuid()); fixtureId String @unique; seed String; homeGoals Int; awayGoals Int; homePossession Int; awayPossession Int; playedAt DateTime; fixture Fixture @relation(fields:[fixtureId],references:[id]); events MatchEvent[] }
model MatchEvent { id String @id @default(cuid()); matchId String; minute Int; type String; actorId String?; data Json; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); @@index([matchId,minute]) }
model Standing { id String @id @default(cuid()); seasonId String; clubId String; played Int @default(0); won Int @default(0); drawn Int @default(0); lost Int @default(0); goalsFor Int @default(0); goalsAgainst Int @default(0); points Int @default(0); season Season @relation(fields:[seasonId],references:[id]); club Club @relation(fields:[clubId],references:[id]); @@unique([seasonId,clubId]) }
model Relationship { id String @id @default(cuid()); saveGameId String; fromType String; fromId String; toType String; toId String; value Int @default(0); updatedAt DateTime @updatedAt; @@unique([saveGameId,fromType,fromId,toType,toId]) }
model Promise { id String @id @default(cuid()); managerId String; playerId String; type String; createdAt DateTime @default(now()); deadline DateTime; progress Int @default(0); status PromiseStatus @default(ACTIVE); importance Int; manager Manager @relation(fields:[managerId],references:[id]); player Player @relation(fields:[playerId],references:[id]); @@index([managerId,status,deadline]) }
model Injury { id String @id @default(cuid()); playerId String; type String; startsAt DateTime; endsAt DateTime; severity Int; player Player @relation(fields:[playerId],references:[id]) }
model Suspension { id String @id @default(cuid()); playerId String; competitionId String; startsAt DateTime; matches Int; served Int @default(0); player Player @relation(fields:[playerId],references:[id]) }
model Transfer { id String @id @default(cuid()); playerId String; fromClubId String?; toClubId String?; type String; fee Decimal? @db.Decimal(14,2); status TransferStatus; createdAt DateTime @default(now()); player Player @relation(fields:[playerId],references:[id]); offers TransferOffer[] }
model TransferOffer { id String @id @default(cuid()); transferId String; clubId String; fee Decimal @db.Decimal(14,2); salary Decimal? @db.Decimal(12,2); status TransferStatus; expiresAt DateTime; transfer Transfer @relation(fields:[transferId],references:[id],onDelete:Cascade) }
model News { id String @id @default(cuid()); saveGameId String; type String; outlet String; headline String; body String; importance Int; publishedAt DateTime @default(now()); metadata Json?; @@index([saveGameId,publishedAt]) }
model SocialPost { id String @id @default(cuid()); saveGameId String; authorType String; authorName String; content String; sentiment Int; publishedAt DateTime @default(now()); metadata Json?; @@index([saveGameId,publishedAt]) }
model InboxMessage { id String @id @default(cuid()); saveGameId String; category MessageCategory; senderType String; senderId String?; subject String; body String; requiresDecision Boolean @default(false); readAt DateTime?; createdAt DateTime @default(now()); metadata Json?; @@index([saveGameId,createdAt]) }
model WorldEvent { id String @id @default(cuid()); saveGameId String; type String; occurredAt DateTime; actors Json; clubId String?; importance Int; sentiment Int; metadata Json?; saveGame SaveGame @relation(fields:[saveGameId],references:[id],onDelete:Cascade); @@index([saveGameId,occurredAt]) }
model BoardExpectation { id String @id @default(cuid()); clubId String; type String; target Json; importance Int; progress Int @default(0); status String; club Club @relation(fields:[clubId],references:[id]) }
